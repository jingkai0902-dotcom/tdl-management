[Unit]
Description=TDL Intake Queue Worker
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/bots/tdl/backend
EnvironmentFile=/opt/bots/tdl/backend/.env
Environment=PYTHONPATH=/opt/bots/tdl/backend
ExecStart=/opt/bots/tdl/backend/.venv/bin/python scripts/run-intake-queue-worker.py
Restart=always
RestartSec=3
User=tdl
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/bots/tdl/backend
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
